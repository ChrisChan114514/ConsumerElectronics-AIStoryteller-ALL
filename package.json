{
  "name": "story-machine-web-service",
  "version": "0.1.0",
  "private": true,
  "description": "AI story generation service and local control console",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.js",
    "iot:check-public": "node IoT/check-public-mqtt.js",
    "iot:simulate": "node IoT/simulate-device.js",
    "iot:start": "node IoT/main.js",
    "iot:test": "node --test IoT/*.test.js",
    "start": "node src/main.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "aedes": "^1.1.1",
    "mqtt": "^5.15.2",
    "mysql2": "^3.14.3"
  }
}

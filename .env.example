# Server
HOST=0.0.0.0
PORT=2210
CORS_ORIGIN=*

# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.deepseek.com/v1
# Leave blank when using the tracked APIkey/DeepseekAPI.txt key file.
LLM_API_KEY=sk-1c09179443aa4e658aaa48f834826abb
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=90000
LLM_RETRY_ATTEMPTS=2
LLM_THINKING=disabled

# Optional alternative to LLM_API_KEY. A file may contain the plain sk- key.
# LLM_API_KEY_FILE=APIkey/DeepseekAPI.txt

# Keep false in production unless model switching is required by a trusted client.
ALLOW_MODEL_OVERRIDE=true

# Local Kokoro TensorRT FP16 teacher service.
TTS_PROVIDER=kokoro
TTS_BASE_URL=http://127.0.0.1:2229
TTS_API_KEY=
TTS_RESOURCE_ID=kokoro-split-hybrid-trt-cuda
TTS_VOICE=af_heart
TTS_TIMEOUT_MS=120000
TTS_SAMPLE_RATE=24000
# TTS_CONFIG_FILE=APIkey/Doubao_TTS.txt

# MySQL story pools, single-card teacher WAV audio, and per-client playback history.
# Set MYSQL_ENABLED=true after creating the database/user from database/bootstrap.sql.
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=2211
MYSQL_USER=story_machine
MYSQL_PASSWORD=123456
MYSQL_DATABASE=kokoro_TensorRT_FP16
MYSQL_CONNECTION_LIMIT=10
MYSQL_TIMEZONE=Z

# IoT MQTT control plane. Port 2215 carries small MQTT control messages only;
# generated MP3 audio remains on the WebService HTTP port (2210).
IOT_HOST=0.0.0.0
IOT_MQTT_PORT=2215
IOT_WEB_SERVICE_URL=http://127.0.0.1:2210
IOT_PUBLIC_AUDIO_BASE_URL=http://120.26.111.75:2210
IOT_MQTT_USERNAME=story-device
IOT_MQTT_PASSWORD=story-test-2026
# ffmpeg converts teacher WAV to the MP3 stream consumed by ESP32.
IOT_FFMPEG_BIN=ffmpeg
IOT_MP3_BITRATE=96k

# Server
HOST=0.0.0.0
PORT=2210
CORS_ORIGIN=*

# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://api.deepseek.com/v1
# Leave blank when using the tracked APIkey/DeepseekAPI.txt key file.
LLM_API_KEY=sk-1c09179443aa4e658aaa48f834826abb
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=90000
LLM_THINKING=disabled

# Optional alternative to LLM_API_KEY. A file may contain the plain sk- key.
# LLM_API_KEY_FILE=APIkey/DeepseekAPI.txt

# Keep false in production unless model switching is required by a trusted client.
ALLOW_MODEL_OVERRIDE=true

# Doubao Seed TTS 2.0. APIkey/Doubao_TTS.txt is used when TTS_API_KEY is blank.
TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
TTS_API_KEY=1f014240-60fe-4113-8263-d59600b3a549
TTS_RESOURCE_ID=seed-tts-2.0
TTS_VOICE=zh_female_vv_uranus_bigtts
TTS_TIMEOUT_MS=120000
TTS_SAMPLE_RATE=24000
# TTS_CONFIG_FILE=APIkey/Doubao_TTS.txt

# MySQL story pools, cached MP3 audio, and per-client playback history.
# Set MYSQL_ENABLED=true after creating the database/user from database/bootstrap.sql.
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=2211
MYSQL_USER=story_machine
MYSQL_PASSWORD=123456
MYSQL_DATABASE=story_machine
MYSQL_CONNECTION_LIMIT=10
MYSQL_TIMEZONE=Z
